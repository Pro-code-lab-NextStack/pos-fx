<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="userManagementContext" prefHeight="428.0" prefWidth="470.0" style="-fx-background-color: rgba(156, 136, 255,0.5);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pcl.pos.controller.UserManagementFormController">
   <children>
      <Label layoutX="28.0" layoutY="14.0" text="User Management" textFill="#192a56">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="3.0" layoutY="42.0" prefHeight="7.0" prefWidth="457.0" style="-fx-background-color: #192a56;" />
      <TextField fx:id="txtUsrName" layoutX="14.0" layoutY="60.0" prefHeight="26.0" prefWidth="129.0" promptText="User Name" />
      <PasswordField fx:id="txtPwd" layoutX="14.0" layoutY="99.0" prefHeight="26.0" prefWidth="129.0" promptText="Password" />
      <TextField fx:id="txtEmail" layoutX="155.0" layoutY="60.0" prefHeight="26.0" prefWidth="129.0" promptText="email" />
      <TextField fx:id="txtContactNumber" layoutX="301.0" layoutY="60.0" prefHeight="26.0" prefWidth="129.0" promptText="Contact Number" />
      <ComboBox fx:id="cmbRole" layoutX="157.0" layoutY="99.0" prefHeight="26.0" prefWidth="129.0" promptText="Select Role" />
      <RadioButton fx:id="rdoApproved" layoutX="14.0" layoutY="139.0" mnemonicParsing="false" prefHeight="18.0" prefWidth="86.0" selected="true" text="Approved">
         <toggleGroup>
            <ToggleGroup fx:id="status" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="rdoPending" layoutX="120.0" layoutY="139.0" mnemonicParsing="false" text="Pending" toggleGroup="$status" />
      <TableView fx:id="tblUser" layoutX="9.0" layoutY="170.0" prefHeight="244.0" prefWidth="457.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
          <TableColumn fx:id="colUserName" prefWidth="110.0" text="UserName" />
            <TableColumn fx:id="colEmail" prefWidth="110.0" text="Email" />
            <TableColumn fx:id="colRole" prefWidth="74.0" text="Role" />
            <TableColumn fx:id="colOption" prefWidth="121.0" text="Option" />
        </columns>
      </TableView>
      <Button fx:id="btnSave" layoutX="306.0" layoutY="99.0" mnemonicParsing="false" onAction="#saveOnAction" prefHeight="26.0" prefWidth="129.0" style="-fx-background-color: #192a56;" text="Save User" textFill="WHITE" />
   </children>
</AnchorPane>
