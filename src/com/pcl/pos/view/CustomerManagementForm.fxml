<AnchorPane fx:id="context" prefHeight="428.0" prefWidth="470.0" style="-fx-background-color: rgba(156, 136, 255,0.5);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pcl.pos.controller.CustomerManagementFormController">
