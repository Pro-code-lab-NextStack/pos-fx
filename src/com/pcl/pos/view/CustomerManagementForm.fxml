      <Button fx:id="btnSave" layoutX="303.0" layoutY="109.0" mnemonicParsing="false" onAction="#saveOnAction" prefHeight="26.0" prefWidth="129.0" style="-fx-background-color: #192a56;" text="Save Customer" textFill="WHITE" />
      <TextField fx:id="txtAddress" layoutX="11.0" layoutY="109.0" prefHeight="26.0" prefWidth="129.0" promptText="Address" />
