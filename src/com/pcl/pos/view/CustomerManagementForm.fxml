      <Label layoutX="25.0" layoutY="24.0" text="Customer  Management" textFill="#192a56">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutY="52.0" prefHeight="7.0" prefWidth="457.0" style="-fx-background-color: #192a56;" />
      <TextField fx:id="txtCustomerName" layoutX="11.0" layoutY="70.0" prefHeight="26.0" prefWidth="129.0" promptText="Customer Name" />
      <TextField fx:id="txtSalary" layoutX="152.0" layoutY="70.0" prefHeight="26.0" prefWidth="129.0" promptText="Salary" />
      <TextField fx:id="txtContactNumber" layoutX="298.0" layoutY="70.0" prefHeight="26.0" prefWidth="129.0" promptText="Contact Number" />
      <TableView fx:id="tblCustomer" layoutX="6.0" layoutY="180.0" prefHeight="244.0" prefWidth="457.0">
         <columns>
